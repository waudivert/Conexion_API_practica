@{
    ViewData["Title"] = "Explorador de contenido aleatorio";
}

<div class="container py-4">

    <div class="text-center mb-5">
        <h1>Explorador de contenido aleatorio</h1>
        <p class="text-muted">
            Citas, perros, gatos y datos curiosos obtenidos desde APIs públicas.
        </p>
    </div>

    <div class="row g-4">

        <!-- CITA -->
        <div class="col-12 col-md-6">
            <div class="card explorador-card h-100">
                <div class="card-body d-flex flex-column">

                    <h2 class="h4">Cita aleatoria</h2>

                    <div id="contenidoCita" class="contenido-api flex-grow-1">
                        <p id="textoCita">Cargando...</p>
                        <p id="autorCita" class="fw-bold"></p>
                    </div>

                    <button id="btnCita"
                            class="btn btn-primary mt-3"
                            type="button">
                        Obtener otra cita
                    </button>

                </div>
            </div>
        </div>


        <!-- PERRO -->
        <div class="col-12 col-md-6">
            <div class="card explorador-card h-100">
                <div class="card-body d-flex flex-column">

                    <h2 class="h4">Perro aleatorio</h2>

                    <div id="contenidoPerro"
                         class="contenido-api flex-grow-1 text-center">

                        <p id="mensajePerro">Cargando...</p>

                        <img id="imagenPerro"
                             class="imagen-api d-none"
                             alt="Imagen aleatoria de un perro" />

                    </div>

                    <button id="btnPerro"
                            class="btn btn-primary mt-3"
                            type="button">
                        Mostrar otro perro
                    </button>

                </div>
            </div>
        </div>


        <!-- GATO -->
        <div class="col-12 col-md-6">
            <div class="card explorador-card h-100">
                <div class="card-body d-flex flex-column">

                    <h2 class="h4">Gato aleatorio</h2>

                    <div id="contenidoGato"
                         class="contenido-api flex-grow-1 text-center">

                        <p id="mensajeGato">Cargando...</p>

                        <img id="imagenGato"
                             class="imagen-api d-none"
                             alt="Imagen aleatoria de un gato" />

                    </div>

                    <button id="btnGato"
                            class="btn btn-primary mt-3"
                            type="button">
                        Mostrar otro gato
                    </button>

                </div>
            </div>
        </div>


        <!-- DATO CURIOSO -->
        <div class="col-12 col-md-6">
            <div class="card explorador-card h-100">
                <div class="card-body d-flex flex-column">

                    <h2 class="h4">Dato curioso</h2>

                    <div id="contenidoDato"
                         class="contenido-api flex-grow-1">

                        <p id="textoDato">Cargando...</p>

                    </div>

                    <button id="btnDato"
                            class="btn btn-primary mt-3"
                            type="button">
                        Mostrar otro dato
                    </button>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/explorador.js" asp-append-version="true"></script>
}